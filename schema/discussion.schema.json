{
  "$id": "https://fmfalgun.github.io/dsa-library/api/v1/schema/discussion.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "patternProperties": {
    "^x_": {}
  },
  "properties": {
    "about": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "created": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "distinct_from": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "minLength": 10,
            "type": "string"
          },
          "slug": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "slug",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "kind": {
      "const": "discussion"
    },
    "question": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\?$",
      "type": "string"
    },
    "refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "minLength": 1,
            "type": "string"
          },
          "url": {
            "pattern": "^https?://",
            "type": "string"
          }
        },
        "required": [
          "label",
          "url"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "show_on": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "slug": {
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "minLength": 1,
            "type": "string"
          },
          "url": {
            "pattern": "^https?://",
            "type": "string"
          }
        },
        "required": [
          "label",
          "url"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "open",
        "answered",
        "superseded"
      ]
    },
    "summary": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "tags": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
    "updated": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "xrefs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "slug",
    "kind",
    "title",
    "summary",
    "status",
    "created",
    "updated",
    "question",
    "about"
  ],
  "title": "dsa-library discussion front matter",
  "type": "object"
}

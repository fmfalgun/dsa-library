{
  "$id": "https://fmfalgun.github.io/dsa-library/api/v1/schema/problem.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "patternProperties": {
    "^x_": {}
  },
  "properties": {
    "created": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "difficulty": {
      "minLength": 1,
      "type": "string"
    },
    "follow_up_of": {
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "found_via": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "kind": {
      "const": "problem"
    },
    "languages": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "minLength": 1,
            "type": "string"
          },
          "url": {
            "pattern": "^https?://",
            "type": "string"
          }
        },
        "required": [
          "label",
          "url"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "show_on": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "similar": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "slug": {
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "unsolved",
        "attempted",
        "solved",
        "revisit"
      ]
    },
    "summary": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "tags": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
    "updated": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "url": {
      "pattern": "^https?://",
      "type": "string"
    },
    "uses": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "xrefs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "slug",
    "kind",
    "title",
    "summary",
    "status",
    "created",
    "updated",
    "source",
    "uses"
  ],
  "title": "dsa-library problem front matter",
  "type": "object"
}

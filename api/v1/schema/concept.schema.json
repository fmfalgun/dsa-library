{
  "$id": "https://fmfalgun.github.io/dsa-library/api/v1/schema/concept.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "patternProperties": {
    "^x_": {}
  },
  "properties": {
    "aliases": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "complexity": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "space": {
            "minLength": 1,
            "type": "string"
          },
          "time": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "time",
          "space"
        ],
        "type": "object"
      },
      "type": "object"
    },
    "created": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "kind": {
      "const": "concept"
    },
    "prerequisites": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "minLength": 1,
            "type": "string"
          },
          "url": {
            "pattern": "^https?://",
            "type": "string"
          }
        },
        "required": [
          "label",
          "url"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "related": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "show_on": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "slug": {
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "status": {
      "enum": [
        "stub",
        "draft",
        "solid"
      ]
    },
    "summary": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "tags": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "enum": [
        "data-structure",
        "algorithm",
        "technique",
        "pattern",
        "paradigm",
        "math"
      ]
    },
    "updated": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "variant_of": {
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "xrefs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "slug",
    "kind",
    "title",
    "summary",
    "status",
    "created",
    "updated",
    "type"
  ],
  "title": "dsa-library concept front matter",
  "type": "object"
}
